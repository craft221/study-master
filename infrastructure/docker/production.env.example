# ==================== DOMAIN ====================
DOMAIN=studymaster.com
ACME_EMAIL=admin@studymaster.com

# ==================== DOCKER ====================
GITHUB_REPOSITORY=your-org/study-master
IMAGE_TAG=latest

# ==================== DATABASE ====================
POSTGRES_USER=studymaster
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=studymaster
DATABASE_URL=postgresql+asyncpg://studymaster:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/studymaster

# ==================== REDIS ====================
REDIS_URL=redis://redis:6379/0

# ==================== SECURITY ====================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ==================== API KEYS ====================
OPENAI_API_KEY=sk-your-openai-api-key

# ==================== MONITORING ====================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Generate with: htpasswd -nb admin password
TRAEFIK_USERS=admin:$apr1$xxxxx

# ==================== OPTIONAL SERVICES ====================
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# AWS S3 for file storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# SMTP for emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@studymaster.com
