# ==================== DOMAIN ====================
DOMAIN=studera.app
ACME_EMAIL=contact@studera.app

# ==================== DOCKER ====================
GITHUB_REPOSITORY=your-org/studera
IMAGE_TAG=latest

# ==================== DATABASE ====================
POSTGRES_USER=studymaster
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=studymaster_db
DATABASE_URL=postgresql+asyncpg://studymaster:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/studymaster_db

# ==================== REDIS ====================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ==================== CELERY ====================
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# ==================== SECURITY ====================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==================== AI (Anthropic Claude) ====================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ==================== EMAIL (Resend) ====================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@studera.app
EMAIL_FROM_NAME=Studera

# ==================== PUSH NOTIFICATIONS (VAPID) ====================
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_CONTACT_EMAIL=contact@studera.app

# ==================== CORS ====================
FRONTEND_URL=https://studera.app
ALLOWED_ORIGINS=https://studera.app,https://www.studera.app

# ==================== ENVIRONMENT ====================
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# ==================== OPTIONAL: MONITORING ====================
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ==================== OPTIONAL: PAYMENTS ====================
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# PAYPAL_CLIENT_ID=xxx
# PAYPAL_CLIENT_SECRET=xxx
# PAYDUNYA_MASTER_KEY=xxx
# PAYDUNYA_PRIVATE_KEY=xxx
# PAYDUNYA_TOKEN=xxx

# ==================== OPTIONAL: BACKUP (S3) ====================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
