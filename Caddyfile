# ===========================================
# STUDERA.APP - Caddy Reverse Proxy
# ===========================================
# Caddy gere automatiquement les certificats SSL (HTTPS)
#
# DNS requis chez ton registrar:
#   A    @      -> IP_SERVEUR
#   A    www    -> IP_SERVEUR
#   A    api    -> IP_SERVEUR
# ===========================================

# Site principal (Frontend Next.js)
studera.app {
    # Rediriger vers le frontend
    reverse_proxy frontend:3000

    # Compression pour performance
    encode gzip

    # Headers de securite
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Redirection www vers non-www
www.studera.app {
    redir https://studera.app{uri} permanent
}

# API Backend (FastAPI)
api.studera.app {
    reverse_proxy backend:8000

    # Compression
    encode gzip

    # Headers CORS sont geres par FastAPI
    # Mais on ajoute des headers de securite
    header {
        X-Content-Type-Options nosniff
    }
}

# Flower (Monitoring Celery) - Protege par auth basique
# Login: admin
# Le mot de passe est stocke en hash bcrypt (cout 14).
# Pour le changer : docker run --rm caddy:2-alpine caddy hash-password --plaintext 'NOUVEAU_MDP'
# puis remplacer le hash ci-dessous, et `docker compose restart caddy`.
flower.studera.app {
    basicauth {
        admin $2a$14$ZY2v.ctp8nV2Wv0L46D8CeZP1kicF7BA1JqIdaTzT0ZzKA16PjLi.
    }
    reverse_proxy flower:5555
}
