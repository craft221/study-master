# ========================================
# STUDERA - CONFIGURATION ENVIRONMENT
# ========================================

# ========== APPLICATION ==========
PROJECT_NAME=Studera
APP_NAME=Studera API
APP_VERSION=1.0.0
DEBUG=True

# ========== SECURITY ==========
# Générer une clé secrète forte avec: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Token Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 jours

# ========== DATABASE ==========
# PostgreSQL Database URL
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://studymaster:studymaster123@postgres:5432/studymaster_db

# ========== REDIS ==========
# Redis URL pour le cache général
REDIS_URL=redis://redis:6379/0

# ========== CELERY & TASK QUEUE ==========
# Celery Broker (Redis)
CELERY_BROKER_URL=redis://redis:6379/1

# Celery Result Backend (Redis)
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ========== INTELLIGENCE ARTIFICIELLE ==========
# Anthropic Claude API Key
# Obtenir une clé sur: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Modèle Claude à utiliser (Claude Sonnet 4.5)
AI_MODEL_CLAUDE=claude-sonnet-4-20250514

# Configuration IA
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Limites de requêtes IA par jour
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PREMIUM=100

# ========== CORS ==========
# URLs autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# ========== EMAIL (Choisir Resend OU SMTP) ==========
# Option 1: Resend (RECOMMANDÉ - gratuit 3000 emails/mois)
# Créer un compte sur https://resend.com et obtenir une API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Option 2: SMTP (fallback si Resend non configuré)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Configuration commune
EMAIL_FROM=noreply@studera.app
EMAIL_FROM_NAME=Studera

# ========== CLOUD STORAGE (Optionnel) ==========
# Pour le stockage d'images et fichiers
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=studera-uploads
# AWS_REGION=eu-west-1

# ========== MONITORING & LOGGING (Optionnel) ==========
# Sentry pour le monitoring d'erreurs
# SENTRY_DSN=your-sentry-dsn

# Log Level
# LOG_LEVEL=INFO

# ========== OCR & FILE PROCESSING (Optionnel) ==========
# Tesseract OCR path (si non dans PATH)
# TESSERACT_PATH=/usr/bin/tesseract

# ========== NOTES ==========
# 1. Ce fichier .env.example sert de template
# 2. Copier ce fichier vers .env et remplir les valeurs réelles
# 3. Ne JAMAIS commiter le fichier .env dans Git
# 4. Les valeurs marquées "Optionnel" ne sont pas requises pour démarrer
# 5. ANTHROPIC_API_KEY est REQUIS pour utiliser les fonctionnalités IA
