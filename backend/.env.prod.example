# ===========================================
# STUDERA.APP - Configuration Production
# ===========================================
# IMPORTANT: Copier ce fichier vers .env et remplir les valeurs
# ===========================================

# Database - Changer les mots de passe en production!
POSTGRES_USER=studymaster
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=studymaster_db
DATABASE_URL=postgresql+asyncpg://studymaster:CHANGE_ME_STRONG_PASSWORD@postgres:5432/studymaster_db

# Security - GÉNÉRER DE NOUVELLES CLÉS!
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_NEW_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# Celery
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# Environment
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=WARNING

# URLs Production
FRONTEND_URL=https://studera.app
ALLOWED_ORIGINS=https://studera.app,https://www.studera.app

# VAPID Keys for Push Notifications
VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_CONTACT_EMAIL=contact@studera.app

# Email - Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@studera.app
EMAIL_FROM_NAME=Studera

# Monitoring - Sentry
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_TRACES_SAMPLE_RATE=0.1
