# ============================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ============================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# ============================================
# API Configuration
# ============================================
# URL de l'API backend (sans slash final)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL de base de l'API (sans /api/v1)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ============================================
# WebSocket Configuration
# ============================================
# Host pour les connexions WebSocket (sans protocole)
NEXT_PUBLIC_WS_HOST=localhost:8000

# ============================================
# Features Toggles
# ============================================
# Activer/désactiver les fonctionnalités
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_OCR=true
NEXT_PUBLIC_ENABLE_MARKETPLACE=true
NEXT_PUBLIC_ENABLE_FOCUS_ROOMS=true
NEXT_PUBLIC_ENABLE_DUELS=true

# ============================================
# Analytics (optional)
# ============================================
# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# ============================================
# Environment
# ============================================
# development | production
NODE_ENV=development
